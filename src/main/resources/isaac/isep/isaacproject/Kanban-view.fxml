<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="isaac.isep.isaacproject.Controllers.KanbanViewController"
      prefHeight="600.0" prefWidth="900.0">

    <MenuBar>
        <Menu text="Projects" fx:id="projectsMenu">
            <!-- Project tabs will be added here -->
        </Menu>
    </MenuBar>

    <TabPane fx:id="projectsTabPane" tabClosingPolicy="UNAVAILABLE">
        <!-- Tabs for each project will be added here -->
    </TabPane>
</VBox>