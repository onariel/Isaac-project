<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="isaac.isep.isaacproject.Controllers.ProjectCreationPageController">
   <children>
      <VBox layoutX="50.0" layoutY="50.0" prefHeight="600.0" spacing="10.0">
         <children>
            <Label text="project creation">
               <font>
                  <Font size="22.0" />
               </font></Label>
            <Label text="New Project Name" />
            <TextField fx:id="projectName" />

            <Label text="Start date" />
            <DatePicker fx:id="startDate" />
            <Label text="End date" />
            <DatePicker fx:id="endDate" />
            <Label text="Budget">
               <graphic>
                  <TextField fx:id="Budget" />
               </graphic>
            </Label>
            <Label text="Description" />
            <TextArea fx:id="projectDescription" />
            <Label fx:id="errorLabel" />
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
               <children>
      
                  <Button onAction="#createProject" text="Save" />
                  <Button mnemonicParsing="false" onAction="#cancelProject" text="Cancel" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
