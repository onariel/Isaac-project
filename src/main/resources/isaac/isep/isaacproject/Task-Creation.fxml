<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="isaac.isep.isaacproject.Controllers.TaskCreationController">
    <children>
        <VBox layoutX="50.0" layoutY="50.0" spacing="10.0">
            <children>
                <Label text="Task Name"/>
                <TextField fx:id="taskNameField"/>

                <Label text="Description"/>
                <TextArea fx:id="descriptionField"/>

                <Label text="Priority"/>
                <TextField fx:id="priorityField"/>

                <Label text="Due Date"/>
                <DatePicker fx:id="dueDatePicker"/>

                <Label text="Status"/>
                <ComboBox fx:id="statusComboBox"/>

                <Label text="Employees"/>
                <VBox fx:id="employeesVBox"/>

                <Label text="Comments"/>
                <TextArea fx:id="commentsField"/>

                <Label text="Project"/>
                <TextField fx:id="projectField"/>

                <Label text="Budget"/>
                <TextField fx:id="budgetField"/>

                <Button text="Create Task" onAction="#createTask"/>
            </children>
        </VBox>
    </children>
</AnchorPane>