<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="isaac.isep.isaacproject.Controllers.ProjectCreationPageController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="600.0">
         <children>
            <HBox alignment="TOP_CENTER" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Name" />
                  <TextField />
               </children>
               <padding>
                  <Insets top="3.0" />
               </padding>
            </HBox>
            <HBox alignment="TOP_CENTER" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Start Date (format: yyyy mm dd hh)" />
                  <TextField />
               </children>
               <padding>
                  <Insets top="3.0" />
               </padding>
            </HBox>
            <HBox alignment="TOP_CENTER" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="End Date (format: yyyy mm dd hh)" />
                  <TextField />
               </children>
               <padding>
                  <Insets top="3.0" />
               </padding>
            </HBox>
            <Label text="Description" />
            <HBox alignment="TOP_CENTER" prefWidth="200.0" spacing="10.0">
               <children>
                  <TextArea prefHeight="200.0" prefWidth="200.0" text="&#10;" />
               </children>
               <padding>
                  <Insets top="3.0" />
               </padding>
            </HBox>
            <HBox alignment="TOP_CENTER" prefWidth="200.0" spacing="20.0">
               <children>
                  <Button fx:id="create" mnemonicParsing="false" onAction="#createProject" text="Create" />
                  <Button fx:id="cancel" mnemonicParsing="false" onAction="#cancelProject" text="Cancel" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
