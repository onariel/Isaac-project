<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="isaac.isep.isaacproject.Controllers.MainPageController">
   <children>
      <VBox fx:id="vBox" prefHeight="720.0" prefWidth="1280.0" spacing="10.0">
         <children>
            <Button onAction="#goToProjectCreation" text="Project Creation" />
            <Button onAction="#goToTaskCreation" text="Task Creation" />
            <Button onAction="#goToTaskManagement" text="Task Management" />
            <Button onAction="#goToEmployeeManagement" text="Employee Management" />
            <Button onAction="#goToProjectManagement" text="Project Management" />
            <Button onAction="#goToKanbanView" text="Kanban View" />
            <Button onAction="#goToCalendarView" text="Calendar View" />
            <Button onAction="#goToGenerationReport" text="Generation Report" />
            <Button mnemonicParsing="false" onAction="#addEmployeeToProject" text="Add Employee to project" />
         </children>
      </VBox>
   </children>
</AnchorPane>
