<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="isaac.isep.isaacproject.Controllers.TaskManagementController">
    <children>
        <VBox layoutX="50.0" layoutY="50.0" spacing="10.0">
            <children>
                <Label text="Current Task Name"/>
                <Label fx:id="currentTaskNameLabel"/>
                <Label text="New Task Name"/>
                <TextField fx:id="taskNameField"/>

                <Label text="Current Description"/>
                <Label fx:id="currentDescriptionLabel"/>
                <Label text="New Description"/>
                <TextArea fx:id="descriptionField"/>

                <Label text="Current Priority"/>
                <Label fx:id="currentPriorityLabel"/>
                <Label text="New Priority"/>
                <TextField fx:id="priorityField"/>

                <Label text="Current Due Date"/>
                <Label fx:id="currentDueDateLabel"/>
                <Label text="New Due Date"/>
                <DatePicker fx:id="dueDatePicker"/>

                <Label text="Current Status"/>
                <Label fx:id="currentStatusLabel"/>
                <Label text="New Status"/>
                <ComboBox fx:id="statusComboBox"/>

                <Label text="Current Employees"/>
                <Label fx:id="currentEmployeesLabel"/>
                <Label text="New Employees"/>
                <VBox fx:id="employeesVBox"/>

                <Label text="Current Comments"/>
                <Label fx:id="currentCommentsLabel"/>
                <Label text="New Comments"/>
                <TextArea fx:id="commentsField"/>

                <Label text="Current Project"/>
                <Label fx:id="currentProjectLabel"/>
                <Label text="New Project"/>
                <TextField fx:id="projectField"/>

                <Label text="Current Budget"/>
                <Label fx:id="currentBudgetLabel"/>
                <Label text="New Budget"/>
                <TextField fx:id="budgetField"/>

                <Button text="Save" onAction="#saveTaskDetails"/>
            </children>
        </VBox>
    </children>
</AnchorPane>