<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="400.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="isaac.isep.isaacproject.Controllers.AddEmployeeToProjectController">
   <children>
      <VBox prefHeight="400.0" prefWidth="300.0" spacing="40.0">
         <children>
            <Label text="project" />
            <ComboBox fx:id="projects" prefWidth="150.0" />
            <Label text="employee email" />
            <TextField fx:id="employeeEmail" />
            <Label fx:id="errorLabel" />
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="50.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addEmployeeToProject" text="add" />
                  <Button mnemonicParsing="false" onAction="#calcel" text="cancel" />
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
