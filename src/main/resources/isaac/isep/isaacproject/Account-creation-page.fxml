<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="isaac.isep.isaacproject.Controllers.AccountCreationPageController">
    <children>
        <VBox alignment="CENTER_RIGHT" prefHeight="400.0" prefWidth="600.0" spacing="20.0">
            <children>
                <HBox alignment="TOP_RIGHT" spacing="10.0">
                    <children>
                        <Label text="Name and surname" />
                        <TextField fx:id="Name" />
                    </children>
                </HBox>
                <HBox alignment="TOP_RIGHT" spacing="10.0">
                    <children>
                        <Label text="Role" />
                        <TextField fx:id="Role" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label text="e-mail address" />
                        <TextField fx:id="email" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label text="Password" />
                        <TextField fx:id="Password" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label text="Confirmation Password" />
                        <TextField fx:id="ConfirmPassword" />
                    </children>
                </HBox>
                <Label fx:id="errorMessage" />
                <HBox alignment="CENTER_RIGHT" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#createAccount" text="create the account" />
                        <Button mnemonicParsing="false" onAction="#clear" text="clear" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
